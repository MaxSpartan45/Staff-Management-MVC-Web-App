@model StaffMember;

@{
	ViewData["Title"] = "Edit Staff Member";
}

<div class="container">
	<div class="row justify-content-center">
		<div class="col-md-8 col-lg-6">
			<h1 class="mb-4">Edit Staff Member</h1>
			<h5>Enter new details below to change them.</h5>
			<p>(Leave blank to keep a fields current value)</p>
			<br>

			<form asp-controller="Staff" asp-action="Edit" method="post" asp-fragment="staffId, fullName, email, position, unit">

				<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
				
				<h3>Details for staff member ID @Model.StaffId</h3>
				<input type="hidden" name="staffId" value="@Model.StaffId"/>
				<hr><br>

				<div class="mb-3">
					<label class="form-label">Full name</label>
					<input class="form-control" name="fullName" placeholder="@Model.FullName"/>
					<span asp-validation-for="FullName" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label for="email" class="form-label">Email</label>
					<input type="email" class="form-control" name="email" placeholder="@Model.Email"/>
					<span asp-validation-for="Email" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label for="position" class="form-label">Position</label>
					<input class="form-control" name="position" placeholder="@Model.Position"/>
					<span asp-validation-for="Position" class="text-danger"></span>
				</div>

				<div class="mb-4">
					<label for="unit" class="form-label">Unit</label>
					<input class="form-control" name="unit" placeholder="@Model.Unit"/>
					<span asp-validation-for="Unit" class="text-danger"></span>
				</div>

				<button type="submit" class="btn btn-primary">Save changes</button>
				<a asp-controller="Staff" asp-action="Index" class="btn btn-secondary">Cancel</a>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
