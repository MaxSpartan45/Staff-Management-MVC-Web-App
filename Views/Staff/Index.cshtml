@using System.Data
@model List<StaffMember>;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @{
        ViewData["Title"] = "Staff List";
    }
</head>
<body>
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <h1>Staff List</h1>
            <div>
                <a class="btn btn-primary" asp-controller="Staff" asp-action="Create">Create</a>
                <a class="btn btn-primary" asp-controller="Staff" asp-action="Search">Search for Member</a>
            </div>
        </div>
    </nav>


    <table class="table">
        <thead>
            <tr>
            <th scope="col">Staff ID</th>
            <th scope="col">Full Name</th>
            <th scope="col">Email</th>
            <th scope="col">Position</th>
            <th scope="col">Unit</th>
            </tr>
        </thead>
        <tbody class="table-group-divider table-divider-color">
            @{
                foreach (var item in @Model) {
                    <tr>
                        <th scope="row">@item.StaffId</th>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.Position</td>
                        <td>@item.Unit</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</body>
</html>